PUID=1000
PGID=1000
TZ=Asia/Bangkok

# Root folder shared by download client + arr apps so hardlinks work
DATA_ROOT=/mnt/f/film-data

# Where each app's config/database lives
CONFIG_ROOT=./appdata

# Beszel hub public key, used by the agent to authenticate the hub.
# Generated on the hub's first run; see docs/technical/MONITORING.md
BESZEL_KEY=""

# Vietnamese AI voice-over. API keys come from Settings > General in each app
# and belong only in the untracked .env file.
VN_DUB_TAG=vn-dub
VN_DUB_ENGINE=vieneu-v2
VN_DUB_INSTALL_VOXCPM=false
# auto: prefer movie storage, then fall back to ext4 at the free-space quota
VN_DUB_PUBLISH_MODE=auto
VN_DUB_SCAN_INTERVAL=3600
VN_DUB_SUPERVISOR_POLL_INTERVAL=30
VN_DUB_LEASE_SECONDS=180
VN_DUB_MIN_MEDIA_FREE_GB=20
VN_DUB_STOP_PUBLISH_FREE_GB=10
VN_DUB_MIN_WORK_FREE_GB=10
VN_DUB_MIN_FREE_VRAM_MB=7000
VN_DUB_REQUIRE_GPU=true
VN_DUB_JELLYFIN_REFRESH=true
VN_DUB_MAX_ATTEMPTS=3
RADARR_URL=http://radarr:7878
RADARR_API_KEY=""
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=""
